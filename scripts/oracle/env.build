# Build/smoke-time environment for the oracle. NOT secrets, and never real ones.
#
# The build must be reproducible by anyone — CI, a fresh clone, an agent — without
# handing out credentials. These are well-formed placeholders that satisfy the
# startup validation so `next build` can prerender. Any route that needs to talk to
# a real Supabase is marked needs_api in routes.json and is skipped unless a real
# ROAM_API_URL is exported by the caller.
#
# A real credential in this file is a bug. Real values come from the environment.
export NEXT_PUBLIC_SUPABASE_URL="${NEXT_PUBLIC_SUPABASE_URL:-https://placeholder.supabase.co}"
export NEXT_PUBLIC_SUPABASE_ANON_KEY="${NEXT_PUBLIC_SUPABASE_ANON_KEY:-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6Im9yYWNsZS1wbGFjZWhvbGRlciJ9.placeholder-signature-not-a-real-key}"
export NEXT_PUBLIC_SITE_URL="${NEXT_PUBLIC_SITE_URL:-http://localhost:3101}"
