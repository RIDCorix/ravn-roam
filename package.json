{
  "name": "roam",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @roam/web dev",
    "dev:web": "pnpm --filter @roam/web dev",
    "dev:landing": "pnpm --filter @roam/landing dev",
    "dev:api": "pnpm --filter @roam/api dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @roam/web build",
    "build:landing": "pnpm --filter @roam/landing build",
    "build:api": "pnpm --filter @roam/api build",
    "start": "pnpm --filter @roam/web start",
    "start:web": "pnpm --filter @roam/web start",
    "start:landing": "pnpm --filter @roam/landing start",
    "clean:generated": "node scripts/clean-generated.mjs",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm clean:generated && pnpm typecheck && pnpm lint && pnpm test && pnpm agent:audit",
    "verify:ci": "pnpm clean:generated && pnpm typecheck && pnpm --filter @roam/web lint && pnpm --filter @roam/landing lint && pnpm --filter @roam/api test && pnpm --filter @roam/catalog test && pnpm agent:audit",
    "verify:web": "pnpm --filter @roam/web typecheck && pnpm --filter @roam/web lint",
    "verify:landing": "pnpm --filter @roam/landing typecheck && pnpm --filter @roam/landing lint",
    "verify:api": "pnpm --filter @roam/api typecheck && pnpm --filter @roam/api test",
    "verify:catalog": "pnpm --filter @roam/catalog typecheck && pnpm --filter @roam/catalog test",
    "verify:lumi-agent": "cd services/lumi-agent && uv run pytest",
    "agent:audit": "node scripts/agent-native-audit.mjs"
  }
}
