# =============================================================================
# @roam/api — environment variables
#
# Copy to `.env` for local dev. Never commit a real `.env*` file.
# All vars are OPTIONAL: the service boots (and `/healthz` answers) even with
# none set — required vars become hard requirements at the point of use
# (e.g., FASTMOVE_* are only enforced inside FastmoveClient).
#
# In deployed envs (Railway) secrets come from the hub per
# `agent-rules/10-secrets-via-linear.md` — never paste them into the dashboard.
# =============================================================================

# ---- Server ----------------------------------------------------------------
PORT=3001
# Surfaced on /healthz so we can confirm which build is live in each env.
# Railway typically injects this as RAILWAY_GIT_COMMIT_SHA; copy to GIT_SHA.
GIT_SHA=

# ---- Database (shared Supabase project: ravn-shared) -----------------------
# Backend-only role with search_path locked to roam_poc + roam_poc_backend.
# Pulled from hub:
#   supabase.shared.poc_roles.roam_poc_backend.connection_url
# Never expose to the browser; never use the shared service_role_key here.
DATABASE_URL=postgres://roam_poc_backend:replace@db.example:5432/postgres?sslmode=require

# ---- Fastmove supplier (世界移動) ------------------------------------------
# Source: ROA-86 Decision D1 (Fastmove API v2.0.3_20260224).
# Two independent environments — production and test each have their own
# MerchantId / DeptId / Token / wmproductId catalogue. NEVER cross them.
#   test:       https://tfmshippingsys.fastmove.com.tw
#   production: https://fmshippingsys.fastmove.com.tw
FASTMOVE_BASE_URL=https://tfmshippingsys.fastmove.com.tw
FASTMOVE_MERCHANT_ID=
FASTMOVE_DEPT_ID=
FASTMOVE_MERCHANT_KEY=

# ---- Admin API (ROA-58 manual-sync button) ---------------------------------
# Required to enable the `/admin/*` routes (supplier-plan sync trigger +
# sync log read). Unset means the routes return 503 — that's the desired
# default in any environment where the admin UI isn't deployed.
# Generate with: `openssl rand -hex 32`.
ADMIN_API_TOKEN=

# ---- OpenAI (Lumi assistant) ----------------------------------------------
# Used by POST /trips/:id/lumi to rearrange itineraries, edit day notes,
# and add/remove days. Without this set the Lumi route returns 503.
OPENAI_API_KEY=
# Model override; defaults to gpt-4.1. Lumi planning relies on strong
# instruction-following over a large structured-output contract — smaller
# models (gpt-4o-mini) drift and produce unstable itineraries.
OPENAI_MODEL=gpt-4.1
# Search model for resolving official ticket/reservation links before
# persisting them to trip attachments.
OPENAI_SEARCH_MODEL=gpt-4o-mini-search-preview
# Server-side Google Places Text Search for resolving Lumi stop names to
# exact Google Maps landmarks before persisting stop coordinates. Optional:
# without it, the API falls back to Nominatim and leaves uncertain stops unpinned.
GOOGLE_MAPS_API_KEY=
# Optional local-dev helper when reusing a browser-restricted Maps key.
# Prefer a server-side Places key in deployed environments.
GOOGLE_MAPS_HTTP_REFERER=http://localhost:3010/

# ---- Gemini (event crawler alternative provider) ---------------------------
# Used by `pnpm --filter @roam/api crawl-shop-events` when present.
# The crawler defaults to Gemini when GEMINI_API_KEY is set, otherwise OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash
# Optional override: gemini | openai.
EVENT_CRAWLER_PROVIDER=gemini
# Optional pacing for weekly full crawls when provider quotas are tight.
EVENT_CRAWLER_REQUEST_DELAY_MS=0
EVENT_CRAWLER_MAX_RETRIES=4

# ---- Supabase auth (JWT verification for storefront APIs) ------------------
# The web app forwards the user's Supabase access token as
# `Authorization: Bearer <jwt>`. The API verifies it using this secret so
# `/trips/*` can scope queries to the authenticated user.
# Pulled from hub: supabase.shared.jwt_secret
SUPABASE_JWT_SECRET=
